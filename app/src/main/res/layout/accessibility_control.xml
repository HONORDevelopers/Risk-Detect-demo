<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_set_white_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"
        android:text="设置白名单" />

    <Button
        android:id="@+id/btn_start_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/btn_set_white_list"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"
        android:text="启动监控" />

    <Button
        android:id="@+id/btn_stop_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/btn_start_control"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"
        android:text="停止监控" />

    <Button
        android:id="@+id/btn_get_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_set_white_list"
        android:layout_margin="16dp"
        android:text="获取状态"/>

    <Button
        android:id="@+id/btn_get_api_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/btn_get_status"
        app:layout_constraintTop_toBottomOf="@+id/btn_set_white_list"
        android:layout_margin="16dp"
        android:text="获取版本号"/>
</androidx.constraintlayout.widget.ConstraintLayout>
